BasedOnStyle: Google
Standard: Latest
ColumnLimit: 160
IndentWidth: 2
DerivePointerAlignment: false
PointerAlignment: Left
QualifierAlignment: Right
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterStruct: true
  AfterUnion: true
  AfterEnum: true
  AfterFunction: true
  AfterControlStatement: Always
  BeforeElse: true
  BeforeCatch: true
  BeforeWhile: true
  AfterNamespace: false
AllowShortFunctionsOnASingleLine: InlineOnly
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AlignTrailingComments:
  Kind: Leave
SortIncludes: CaseSensitive
SpacesBeforeTrailingComments: 1
SpaceInEmptyBraces: Block
CommentPragmas: '^(static$|FIXME:)'
IncludeIsMainRegex: '$^'
IncludeBlocks: Regroup
IncludeCategories:
  # sys.h must be the first header at all times.
  - Regex: '^"sys.h"'
    Priority: 1
    SortPriority: -1
  # Next, match all ava/ headers, giving them roughly the order where the most dependent subdirectory is included first.
  - Regex: '^"ava/app'
    Priority: 1
    SortPriority: 3
  - Regex: '^"ava/agent'
    Priority: 1
    SortPriority: 4
  - Regex: '^"ava/tools'
    Priority: 1
    SortPriority: 5
  - Regex: '^"ava/tui'
    Priority: 1
    SortPriority: 6
  - Regex: '^"ava/plugin'
    Priority: 1
    SortPriority: 7
  - Regex: '^"ava/mcp'
    Priority: 1
    SortPriority: 8
  - Regex: '^"ava/config'
    Priority: 1
    SortPriority: 9
  - Regex: '^"ava/session'
    Priority: 1
    SortPriority: 10
  - Regex: '^"ava/permissions'
    Priority: 1
    SortPriority: 11
  - Regex: '^"ava/provider'
    Priority: 1
    SortPriority: 12
  - Regex: '^"ava/context'
    Priority: 1
    SortPriority: 13
  - Regex: '^"ava/lsp'
    Priority: 1
    SortPriority: 14
  - Regex: '^"ava/core'
    Priority: 1
    SortPriority: 15
  # This is the catch-all for any additional (future) ava/ subdirectories.
  # It get a sort priority smaller than the rest because it will be more dependent (none of the above should depend on it, as these are newer).
  - Regex: '^"ava/'
    Priority: 1
    SortPriority: 2

  # Separated with an empty line comes the group that includes <> headers, with "debug.h" as last below that.
  # This is because "debug.h" defines quite some macros that *might* give problems with arbitrary other headers.
  - Regex: '^<[^.]*>'
    Priority: 2
    SortPriority: 21
  - Regex: '^<.*\..*>'
    Priority: 2
    SortPriority: 22
  - Regex: '^"debug.h"'
    Priority: 2
    SortPriority: 23

  # This is a special file that always must be included last because it tremendously polutes global namespace and adds ridiculous macros.
  - Regex: '^"private_convert.h"'
    Priority: 3
    SortPriority: 31

  # This is the catch-all for any remaining includes that use double quotes.
  # They go above the ava/ includes, but still in the same group (no empty line between them),
  # because in theory these are headers of the current subdirectory that should be considered
  # more dependent then any external headers being included.
  - Regex: '^"'
    Priority: 1
    SortPriority: 1
