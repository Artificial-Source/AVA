{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 27,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Developer build",
      "description": "Configure an optimized developer build with assertions, debug instrumentation, tests, and compile commands enabled.",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "EnableAvaBuildTests": "ON",
        "CMAKE_BUILD_TYPE": "BetaTest",
        "EnableDebug": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "sanitize",
      "displayName": "Sanitizer build",
      "description": "Configure a test build with AddressSanitizer and UndefinedBehaviorSanitizer enabled.",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build-sanitize",
      "cacheVariables": {
        "EnableAvaSanitizers": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "Focused ThreadSanitizer build",
      "description": "Configure ThreadSanitizer for deterministic coordinator and ACP peer race tests.",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build-tsan",
      "cacheVariables": {
        "AVA_ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release build",
      "description": "Configure an optimized build with the release/RPC contract tests available.",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "EnableAvaBuildTests": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-rpc",
      "configurePreset": "release",
      "filter": {
        "include": {
          "name": "rpc"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitize-rpc",
      "configurePreset": "sanitize",
      "filter": {
        "include": {
          "name": "rpc"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-acp",
      "configurePreset": "release",
      "filter": {
        "include": {
          "name": "acp"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitize-acp",
      "configurePreset": "sanitize",
      "filter": {
        "include": {
          "name": "acp"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "filter": {
        "include": {
          "name": "^ava_tests\\.(session_run_controller|subagent_coordinator|subagent_delivery_manager|acp)$"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
